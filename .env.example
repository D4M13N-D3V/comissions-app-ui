# Copy to .env.local (dev) and provide real values via your deployment platform (prod).
# NEVER commit a populated env file — secrets must not live in git.

# --- Auth0 ---
# Your Auth0 tenant issuer, e.g. https://your-tenant.us.auth0.com
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
# Auth0 application client secret. Keep secret; rotate if ever exposed.
AUTH0_CLIENT_SECRET=
# Public base URL of THIS app. Dev: http://localhost:3000 . Prod: https://<your-domain> (HTTPS).
AUTH0_BASE_URL=
# Independent 32+ byte random value used to encrypt the session cookie.
# Generate with: openssl rand -hex 32   (must NOT equal AUTH0_CLIENT_SECRET)
AUTH0_SECRET=
# API identifier configured in Auth0.
AUTH0_AUDIENCE=
# Space-separated OAuth scopes requested for the access token.
AUTH0_SCOPE=

# --- Core API ---
# Base URL of the core API this UI proxies to.
NEXT_PUBLIC_API_URL=
